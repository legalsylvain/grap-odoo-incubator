<odoo>


    <record id="account_config_settings_view_form" model="ir.ui.view">
        <field name="model">account.config.settings</field>
        <field name="arch" type="xml">
            <form string="Settings" class="oe_form_configuration o_base_settings" js_class="base_settings">
                <div class="o_setting_container">
                    <div class="settings">
                        <div class="app_settings_block" data-string="General Settings" string="General Settings" data-key="general_settings">


                            <div id="bullshit">
                                <h2>bullshit</h2>
                                <div class="row mt16 o_settings_container" name="users_setting_container">

                                    <div class="col-12 col-lg-6 o_setting_box">
                                        <div class="o_setting_left_pane"/>
                                        <div class="o_setting_right_pane">
                                            <span class="o_form_label">company</span>
                                            <div class="content-group">
                                                <div class="row mt16">
                                                    <label string="Company" for="company_id" class="col-lg-3 o_light_label"/>
                                                    <field name="company_id"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div id="accounting_settings">
                                <h2>Accounting Settings</h2>
                                <div class="row mt16 o_settings_container" name="users_setting_container">

                                    <div class="col-12 col-lg-6 o_setting_box">
                                        <div class="o_setting_left_pane"/>
                                        <div class="o_setting_right_pane">
                                            <span class="o_form_label">Fiscal years</span>
                                            <div class="text-muted">
                                                Day and Month of the end of the fiscal year
                                            </div>
                                            <div class="content-group">
                                                <div class="row mt16">
                                                    <label string="Last Day" for="fiscalyear_last_day" class="col-lg-3 o_light_label"/>
                                                    <field name="fiscalyear_last_day"/>
                                                </div>
                                                <div class="row">
                                                    <label string="Last Month" for="fiscalyear_last_month" class="col-lg-3 o_light_label"/>
                                                    <field name="fiscalyear_last_month"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-6 o_setting_box">
                                        <div class="o_setting_left_pane"/>
                                        <div class="o_setting_right_pane">
                                            <span class="o_form_label">Lock Dates</span>
                                            <div class="text-muted">
                                                Prevent accounting changes prior of Lock Dates
                                            </div>
                                            <div class="content-group">
                                                <div class="row mt16">
                                                    <label string="Lock Date for Non-Advisers" for="period_lock_date" class="col-lg-3 o_light_label"/>
                                                    <field name="period_lock_date"/>
                                                </div>
                                                <div class="row">
                                                    <label string="Lock Date" for="fiscalyear_lock_date" class="col-lg-3 o_light_label"/>
                                                    <field name="fiscalyear_lock_date"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <record id="account_config_settings_act_window" model="ir.actions.act_window">
        <field name="name">Accounting Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'general_settings', 'bin_size': False}</field>

    </record>

    <menuitem
        id="menu_account_config_settings"
        name="Accounting Settings"
        parent="account.menu_finance"
        sequence="30"
        action="account_config_settings_act_window"/>

</odoo>


